#%Module######################################################################
##
##      METcalcpy
##
proc ModulesHelp { } {
  puts stderr "Sets up the paths and environment variables to use the METcalcpy-13.0.0.
     *** For help see the official MET webpage at http://www.dtcenter.org/met/users ***"
}

prereq intel-oneapi-compilers/2026.1.0

prepend-path PATH /scratch3/BMC/dtc/METplus/miniconda/miniconda3/envs/metplus_v13.0_py3.14/bin
prepend-path PYTHONPATH	/contrib/METcalcpy/METcalcpy-13.0.0
