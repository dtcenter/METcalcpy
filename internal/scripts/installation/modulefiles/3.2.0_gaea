#%Module######################################################################
##
##      METcalcpy
##
proc ModulesHelp { } {
  puts stderr "Sets up the paths and environment variables to use the METcalcpy-3.2.0.
     *** For help see the official MET webpage at http://www.dtcenter.org/met/users ***"
}

module unload cray-libsci/24.07.0
module load intel/2023.2.0

prepend-path PATH /ncrc/proj/nggps_psd/Julie.Prestopnik/projects/miniconda/miniconda3/envs/metplus_v6.1_py3.12/bin
prepend-path PYTHONPATH /usw/met/METcalcpy/METcalcpy-3.2.0
